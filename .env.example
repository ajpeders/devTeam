# Platform admin API key. Send as X-Api-Key to access admin-gated endpoints.
# Required: the daemon refuses to start if this and config.api.admin_api_key are both empty.
MYDEVTEAM_API_KEY=

# Comma-separated, case-insensitive email allowlist. Matching DB users are auto-promoted
# to admin at startup. Empty/unset = no auto-admins (safe default).
MYDEVTEAM_ADMIN_EMAILS=

# Comma-separated extra CORS origins. Unioned with dev defaults
# (http://localhost:5173, http://127.0.0.1:5173). Leave unset for local-only dev.
MYDEVTEAM_ALLOWED_ORIGINS=
